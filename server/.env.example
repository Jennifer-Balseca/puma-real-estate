# Configuración del Servidor
PORT=5000

# URL del frontend en producción (Vercel). Se usa para configurar CORS.
# En desarrollo local puedes omitirla (localhost:5173 ya está permitido por defecto).
# Ejemplo: https://puma-real-estate.vercel.app
CLIENT_URL=https://tu-app.vercel.app

# Conexión con MongoDB Atlas
MONGO_URI=mongodb+srv://<usuario>:<password>@pumarealestate.r5rzfhm.mongodb.net/PumaRealEstate?retryWrites=true&w=majority

# Conexión directa opcional para redes con problemas de resolución SRV
# Usar cuando la red no puede resolver URIs SRV (ej: algunos entornos de CI/CD)
MONGO_URI_DIRECT=mongodb://<usuario>:<password>@<host1>:27017,<host2>:27017,<host3>:27017/PumaRealEstate?replicaSet=<replicaSet>&authSource=admin&retryWrites=true&w=majority

# Autenticación JWT
JWT_SECRET=clave_secreta_para_desarrollo

# Firebase Admin SDK — Gestión de archivos en Firebase Storage (server-side)
# FIREBASE_SERVICE_ACCOUNT_BASE64: JSON del service account de Firebase codificado en Base64
# Obtener en: Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
# Codificar con: base64 -w 0 serviceAccountKey.json  (Linux/Mac) o en PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=<json_de_service_account_en_base64>

# Nombre del bucket de Firebase Storage (formato: proyecto.appspot.com o proyecto.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=your_firebase_project.firebasestorage.app