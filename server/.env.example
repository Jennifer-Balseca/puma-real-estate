# Configuración del Servidor
PORT=5000

# Conexión con MongoDB Atlas
# Si falla por red o DNS, usa la cadena larga de shards del cluster.
MONGO_URI=mongodb+srv://<usuario>:<password>@pumarealestate.r5rzfhm.mongodb.net/PumaRealEstate?retryWrites=true&w=majority

# Autenticación JWT 
JWT_SECRET=clave_secreta_para_desarrollo

# Configuración de Firebase Storage (Para gestión multimedia)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_firebase_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_firebase_project.appspot.com