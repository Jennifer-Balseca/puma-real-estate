# URL base de la API backend (Express + Socket.IO)
# Local: http://localhost:5000
# Produccion: URL de Render, ej: https://puma-real-estate-api.onrender.com
VITE_API_URL=http://localhost:5000

# Firebase SDK (cliente) -- Configuracion para Firebase Storage (subida de multimedia)
# Obtener en: Firebase Console -> Configuracion del proyecto -> Tus aplicaciones -> SDK setup
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
